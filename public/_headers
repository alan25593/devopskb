# Next emits content-hashed file names under /_next/static: safe to cache forever
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Stable-name assets: cache a day, revalidate after
/og-image.jpg
  Cache-Control: public, max-age=86400
/apple-touch-icon.png
  Cache-Control: public, max-age=86400
/diagramas/*
  Cache-Control: public, max-age=86400
